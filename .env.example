# ==============================================================================
# ApexLedger Enterprise ERP — Environment Configuration
# Copy this file to .env.local (for local dev) or add these keys in Vercel.
# ==============================================================================

# MongoDB Atlas Connection String (leave blank to run in auto-seeded local mode)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/apexledger_erp?retryWrites=true&w=majority

# Cryptographic JWT Secret (minimum 32 random characters in production)
JWT_SECRET=replace-with-a-64-char-cryptographically-random-secret-key-for-prod

# Encryption key for sensitive settings / backup integrity HMAC
DATA_ENCRYPTION_KEY=replace-with-32-byte-hex-encryption-key-for-production

# Application URL (used in emailed invoices & links)
NEXT_PUBLIC_APP_URL=https://your-vercel-app.vercel.app

# Optional: SMTP / Email Provider (for live email dispatch)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=billing@apexledger-enterprise.com

# Optional: AI Provider Key (built-in deterministic BI Copilot works without a key)
OPENAI_API_KEY=
GEMINI_API_KEY=
